generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int      @id @default(autoincrement())
  name          String
  email         String   @unique
  password_hash String
  role          String   @default("admin")
  created_at    DateTime @default(now())

  turism_spots TurismSpot[]
  pets         Pet[]
  courses      Course[]
  properties   Property[]
  dishes       Dish[]
  plans        Plan[]
  modalities   Modality[]
  events       Event[]
}

model TurismSpot {
  id              Int      @id @default(autoincrement())
  name            String
  description     String   @db.VarChar(200)
  district        String
  category        String
  latitude        Float
  longitude       Float
  requires_ticket Boolean  @default(false)
  created_by      Int
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  author User         @relation(fields: [created_by], references: [id])
  images TurismImage[]
}

model TurismImage {
  id       Int    @id @default(autoincrement())
  spot_id  Int
  file_url String

  spot TurismSpot @relation(fields: [spot_id], references: [id], onDelete: Cascade)
}

// ─── Atividade 1: Amigo Fiel — Portal de Adoção de Pets ─────────────────────

model Pet {
  id          Int      @id @default(autoincrement())
  name        String
  species     String
  age         Int
  size        String
  description String?  @db.Text
  status      String   @default("disponivel")
  created_by  Int
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  author User @relation(fields: [created_by], references: [id])
}

// ─── Atividade 2: EduTech — Catálogo de Cursos Online ────────────────────────

model Course {
  id          Int      @id @default(autoincrement())
  title       String
  instructor  String
  category    String
  workload    Int
  price       Float
  description String?  @db.Text
  created_by  Int
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  author User @relation(fields: [created_by], references: [id])
}

// ─── Atividade 3: EasyHome — Sistema de Imobiliária ─────────────────────────

model Property {
  id          Int      @id @default(autoincrement())
  type        String
  address     String
  area        Float
  price       Float
  modality    String
  description String?  @db.Text
  status      String   @default("disponivel")
  created_by  Int
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  author User @relation(fields: [created_by], references: [id])
}

// ─── Atividade 4: Chef's Menu — Cardápio Digital ─────────────────────────────

model Dish {
  id          Int      @id @default(autoincrement())
  name        String
  category    String
  price       Float
  description String?  @db.Text
  available   Boolean  @default(true)
  created_by  Int
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  author User @relation(fields: [created_by], references: [id])
}

// ─── Atividade 5: Fitness Hub — Gestão de Planos e Treinos ──────────────────

model Plan {
  id               Int      @id @default(autoincrement())
  name             String
  type             String
  price            Float
  weekly_frequency Int
  description      String   @db.Text
  created_by       Int
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  author User @relation(fields: [created_by], references: [id])
}

model Modality {
  id          Int      @id @default(autoincrement())
  name        String
  description String   @db.Text
  level       String
  status      String   @default("ativa")
  created_by  Int
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  author User @relation(fields: [created_by], references: [id])
}

// ─── Atividade 6: Event-IT — Plataforma de Eventos ──────────────────────────

model Event {
  id               Int      @id @default(autoincrement())
  name             String
  category         String
  date_time        DateTime
  location         String
  description      String?  @db.Text
  max_capacity     Int
  registered_count Int      @default(0)
  created_by       Int
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  author User @relation(fields: [created_by], references: [id])
}

// ─── 5 NOVOS PROJETOS ────────────────────────────────────────────────────────

// 1. MODA
model ModaItem {
  id         String  @id @default(uuid())
  nome       String
  categoria  String
  preco      Float
  descricao  String  @db.Text
  imagem_url String
  tag        String?
}

// 2. STREAMING
model Movie {
  id             String @id @default(uuid())
  titulo         String
  genero         String
  ano_lancamento Int
  nota           String
  imagem_url     String
}

model StreamingStats {
  id                     String   @id @default(uuid())
  mais_assistidos_semana String[]
  total_horas_assistidas String
}

// 3. RECEITAS
model Recipe {
  id                      String   @id @default(uuid())
  categoria               String
  titulo                  String
  ingredientes_principais String[]
  tempo_preparo           String
  dificuldade             String
  imagem_url              String
}

// 4. EVENTOS (Nomeado como EventProject e EventDashboard para evitar conflito com Event)
model EventProject {
  id                  String @id @default(uuid())
  nome                String
  data                String
  local               String
  ingressos_restantes Int
  imagem_url          String
}

model EventDashboard {
  id                    String @id @default(uuid())
  total_eventos         Int
  eventos_proximos      Int
  ingressos_disponiveis Int
}

// 6. ARTIGOS
model Artigo {
  id               String   @id @default(uuid())
  titulo           String
  descricao        String   @db.Text
  categoria        String
  tempo_leitura    Int
  imagem           String?
  data_publicacao  DateTime
}

// 5. HARDWARE (original — mantido por ordem histórica)
model HardwareItem {
  id                      String @id @default(uuid())
  titulo                  String
  tipo                    String
  fabricante              String
  especificacao_principal String
  preco                   Float
  imagem_url              String
}

model HardwareVideo {
  id        String @id @default(uuid())
  url       String
  titulo    String
  descricao String @db.Text
}

// ═════════════════════════════════════════════════════════════════════════════
// PROJETO 1 — Dentro do Jogo (Portal Copa do Mundo FIFA 2026)  /api/dentro-do-jogo
// ═════════════════════════════════════════════════════════════════════════════

model Group {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  image       String?
  teams       Team[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Team {
  id           Int      @id @default(autoincrement())
  name         String
  countryCode  String
  groupId      Int
  group        Group    @relation(fields: [groupId], references: [id])
  wins         Int      @default(0)
  losses       Int      @default(0)
  draws        Int      @default(0)
  points       Int      @default(0)
  goalsFor     Int      @default(0)
  goalsAgainst Int      @default(0)
  image        String?
  homeMatches  Match[]  @relation("HomeTeam")
  awayMatches  Match[]  @relation("AwayTeam")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Match {
  id         Int      @id @default(autoincrement())
  homeTeamId Int
  awayTeamId Int
  homeTeam   Team     @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam   Team     @relation("AwayTeam", fields: [awayTeamId], references: [id])
  homeScore  Int?
  awayScore  Int?
  matchDate  DateTime
  stadium    String
  city       String
  stage      String
  status     String   @default("Agendado")
  image      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model News {
  id          Int      @id @default(autoincrement())
  title       String
  content     String   @db.Text
  summary     String
  author      String
  publishedAt DateTime
  category    String
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ═════════════════════════════════════════════════════════════════════════════
// PROJETO 2 — Pitoco's Car (eventos de carros)            /api/pitocos-car
// ═════════════════════════════════════════════════════════════════════════════

model CarEvent {
  id                Int                   @id @default(autoincrement())
  title             String
  organizerName     String
  organizerBio      String
  organizerPhoto    String?
  eventDate         DateTime
  description       String
  vehicleLimit      Int
  ticketPrice       Decimal?
  ticketDescription String?
  image             String?
  registrations     VehicleRegistration[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
}

model VehicleRegistration {
  id                 Int      @id @default(autoincrement())
  eventId            Int
  event              CarEvent @relation(fields: [eventId], references: [id])
  ownerName          String
  ownerEmail         String
  vehicleName        String
  vehicleYear        Int
  vehicleDescription String
  status             String   @default("Pendente")
  image              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ═════════════════════════════════════════════════════════════════════════════
// PROJETO 3 — Lumière (loja de roupas)                    /api/lumiere
// ═════════════════════════════════════════════════════════════════════════════

model ClothingCategory {
  id          Int               @id @default(autoincrement())
  name        String
  description String?
  image       String?
  products    ClothingProduct[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model ClothingProduct {
  id            Int              @id @default(autoincrement())
  name          String
  description   String?
  price         Decimal
  categoryId    Int
  category      ClothingCategory @relation(fields: [categoryId], references: [id])
  image         String?
  stockEntries  ClothingStock[]
  purchaseItems PurchaseItem[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model ClothingSize {
  id            Int             @id @default(autoincrement())
  label         String          @unique
  image         String?
  stockEntries  ClothingStock[]
  purchaseItems PurchaseItem[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model ClothingStock {
  id        Int             @id @default(autoincrement())
  productId Int
  sizeId    Int
  product   ClothingProduct @relation(fields: [productId], references: [id])
  size      ClothingSize    @relation(fields: [sizeId], references: [id])
  quantity  Int             @default(0)
  image     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([productId, sizeId])
}

model Purchase {
  id            Int            @id @default(autoincrement())
  customerName  String
  customerEmail String
  total         Decimal
  status        String         @default("Pendente")
  image         String?
  items         PurchaseItem[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model PurchaseItem {
  id         Int             @id @default(autoincrement())
  purchaseId Int
  productId  Int
  sizeId     Int
  purchase   Purchase        @relation(fields: [purchaseId], references: [id])
  product    ClothingProduct @relation(fields: [productId], references: [id])
  size       ClothingSize    @relation(fields: [sizeId], references: [id])
  quantity   Int
  unitPrice  Decimal
  image      String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

// ═════════════════════════════════════════════════════════════════════════════
// PROJETO 4 — Nexus (loja de eletrônicos)                 /api/nexus
// ═════════════════════════════════════════════════════════════════════════════

model ElectronicCategory {
  id          Int                 @id @default(autoincrement())
  name        String
  description String?
  image       String?
  products    ElectronicProduct[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model ElectronicProduct {
  id                Int                @id @default(autoincrement())
  name              String
  categoryId        Int
  category          ElectronicCategory @relation(fields: [categoryId], references: [id])
  brand             String
  description       String
  price             Decimal
  stockQuantity     Int                @default(0)
  lowStockThreshold Int                @default(5)
  sku               String             @unique
  image             String?
  orderItems        OrderItem[]
  cartItems         CartItem[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Customer {
  id        Int        @id @default(autoincrement())
  name      String
  email     String     @unique
  password  String
  phone     String?
  address   String?
  role      String     @default("customer")
  image     String?
  orders    Order[]
  cartItems CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Order {
  id         Int         @id @default(autoincrement())
  customerId Int
  customer   Customer    @relation(fields: [customerId], references: [id])
  total      Decimal
  status     String      @default("Pendente")
  image      String?
  items      OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model OrderItem {
  id        Int               @id @default(autoincrement())
  orderId   Int
  productId Int
  order     Order             @relation(fields: [orderId], references: [id])
  product   ElectronicProduct @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal
  image     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model CartItem {
  id         Int               @id @default(autoincrement())
  customerId Int
  productId  Int
  customer   Customer          @relation(fields: [customerId], references: [id])
  product    ElectronicProduct @relation(fields: [productId], references: [id])
  quantity   Int
  image      String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([customerId, productId])
}

// ═════════════════════════════════════════════════════════════════════════════
// PROJETO 5 — Maxblock (catálogo de jogos)                /api/maxblock
// ═════════════════════════════════════════════════════════════════════════════

model GameCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  image     String?
  games     Game[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Game {
  id          Int          @id @default(autoincrement())
  name        String
  description String
  categoryId  Int
  category    GameCategory @relation(fields: [categoryId], references: [id])
  ageRating   String
  controls    String
  likesCount  Int          @default(0)
  gameUrl     String
  image       String?
  likes       GameLike[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model GameLike {
  id             Int      @id @default(autoincrement())
  gameId         Int
  game           Game     @relation(fields: [gameId], references: [id])
  userIdentifier String
  createdAt      DateTime @default(now())

  @@unique([gameId, userIdentifier])
}

// ═════════════════════════════════════════════════════════════════════════════
// PROJETO 6 — Swell Point (praias e eventos de surf)      /api/swell-point
// ═════════════════════════════════════════════════════════════════════════════

model Beach {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SurfEvent {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
