generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int      @id @default(autoincrement())
  name          String
  email         String   @unique
  password_hash String
  role          String   @default("admin")
  created_at    DateTime @default(now())

  turism_spots TurismSpot[]
  pets         Pet[]
  courses      Course[]
  properties   Property[]
  dishes       Dish[]
  plans        Plan[]
  modalities   Modality[]
  events       Event[]
}

model TurismSpot {
  id              Int      @id @default(autoincrement())
  name            String
  description     String   @db.VarChar(200)
  district        String
  category        String
  latitude        Float
  longitude       Float
  requires_ticket Boolean  @default(false)
  created_by      Int
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  author User         @relation(fields: [created_by], references: [id])
  images TurismImage[]
}

model TurismImage {
  id       Int    @id @default(autoincrement())
  spot_id  Int
  file_url String

  spot TurismSpot @relation(fields: [spot_id], references: [id], onDelete: Cascade)
}

// ─── Atividade 1: Amigo Fiel — Portal de Adoção de Pets ─────────────────────

model Pet {
  id          Int      @id @default(autoincrement())
  name        String
  species     String
  age         Int
  size        String
  description String?  @db.Text
  status      String   @default("disponivel")
  created_by  Int
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  author User @relation(fields: [created_by], references: [id])
}

// ─── Atividade 2: EduTech — Catálogo de Cursos Online ────────────────────────

model Course {
  id          Int      @id @default(autoincrement())
  title       String
  instructor  String
  category    String
  workload    Int
  price       Float
  description String?  @db.Text
  created_by  Int
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  author User @relation(fields: [created_by], references: [id])
}

// ─── Atividade 3: EasyHome — Sistema de Imobiliária ─────────────────────────

model Property {
  id          Int      @id @default(autoincrement())
  type        String
  address     String
  area        Float
  price       Float
  modality    String
  description String?  @db.Text
  status      String   @default("disponivel")
  created_by  Int
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  author User @relation(fields: [created_by], references: [id])
}

// ─── Atividade 4: Chef's Menu — Cardápio Digital ─────────────────────────────

model Dish {
  id          Int      @id @default(autoincrement())
  name        String
  category    String
  price       Float
  description String?  @db.Text
  available   Boolean  @default(true)
  created_by  Int
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  author User @relation(fields: [created_by], references: [id])
}

// ─── Atividade 5: Fitness Hub — Gestão de Planos e Treinos ──────────────────

model Plan {
  id               Int      @id @default(autoincrement())
  name             String
  type             String
  price            Float
  weekly_frequency Int
  description      String   @db.Text
  created_by       Int
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  author User @relation(fields: [created_by], references: [id])
}

model Modality {
  id          Int      @id @default(autoincrement())
  name        String
  description String   @db.Text
  level       String
  status      String   @default("ativa")
  created_by  Int
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  author User @relation(fields: [created_by], references: [id])
}

// ─── Atividade 6: Event-IT — Plataforma de Eventos ──────────────────────────

model Event {
  id               Int      @id @default(autoincrement())
  name             String
  category         String
  date_time        DateTime
  location         String
  description      String?  @db.Text
  max_capacity     Int
  registered_count Int      @default(0)
  created_by       Int
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  author User @relation(fields: [created_by], references: [id])
}

// ─── 5 NOVOS PROJETOS ────────────────────────────────────────────────────────

// 1. MODA
model ModaItem {
  id         String  @id @default(uuid())
  nome       String
  categoria  String
  preco      Float
  descricao  String  @db.Text
  imagem_url String
  tag        String?
}

// 2. STREAMING
model Movie {
  id             String @id @default(uuid())
  titulo         String
  genero         String
  ano_lancamento Int
  nota           String
  imagem_url     String
}

model StreamingStats {
  id                     String   @id @default(uuid())
  mais_assistidos_semana String[]
  total_horas_assistidas String
}

// 3. RECEITAS
model Recipe {
  id                      String   @id @default(uuid())
  categoria               String
  titulo                  String
  ingredientes_principais String[]
  tempo_preparo           String
  dificuldade             String
  imagem_url              String
}

// 4. EVENTOS (Nomeado como EventProject e EventDashboard para evitar conflito com Event)
model EventProject {
  id                  String @id @default(uuid())
  nome                String
  data                String
  local               String
  ingressos_restantes Int
  imagem_url          String
}

model EventDashboard {
  id                    String @id @default(uuid())
  total_eventos         Int
  eventos_proximos      Int
  ingressos_disponiveis Int
}

// 6. ARTIGOS
model Artigo {
  id               String   @id @default(uuid())
  titulo           String
  descricao        String   @db.Text
  categoria        String
  tempo_leitura    Int
  imagem           String?
  data_publicacao  DateTime
}

// 5. HARDWARE (original — mantido por ordem histórica)
model HardwareItem {
  id                      String @id @default(uuid())
  titulo                  String
  tipo                    String
  fabricante              String
  especificacao_principal String
  preco                   Float
  imagem_url              String
}

model HardwareVideo {
  id        String @id @default(uuid())
  url       String
  titulo    String
  descricao String @db.Text
}

// ─── Dentro do Jogo — Portal Copa do Mundo FIFA 2026 ─────────────────────────

model Group {
  id          String  @id @default(uuid())
  name        String
  description String?
  image       String? // URL pública (Vercel Blob)

  teams Team[]
}

model Team {
  id            Int     @id @default(autoincrement())
  name          String
  country_code  String
  group_id      String?
  wins          Int     @default(0)
  losses        Int     @default(0)
  draws         Int     @default(0)
  points        Int     @default(0)
  goals_for     Int     @default(0)
  goals_against Int     @default(0)
  image         String? // URL pública (Vercel Blob)

  group        Group?  @relation(fields: [group_id], references: [id], onDelete: SetNull)
  home_matches Match[] @relation("HomeTeam")
  away_matches Match[] @relation("AwayTeam")
}

model Match {
  id           Int      @id @default(autoincrement())
  home_team_id Int
  away_team_id Int
  home_score   Int?
  away_score   Int?
  match_date   DateTime
  stadium      String
  city         String
  stage        String
  status       String   @default("Agendado")
  image        String? // URL pública (Vercel Blob)

  home_team Team @relation("HomeTeam", fields: [home_team_id], references: [id])
  away_team Team @relation("AwayTeam", fields: [away_team_id], references: [id])
}

model News {
  id           String   @id @default(uuid())
  title        String
  content      String   @db.Text
  summary      String
  author       String
  published_at DateTime
  category     String
  image        String? // URL pública (Vercel Blob)
}
